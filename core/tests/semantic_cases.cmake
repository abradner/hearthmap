# Turns schema/semantic-cases.json into a C++ table (semantic_cases.h) at configure time, so
# core's tests read the same cases as the editor's without core's tests needing a JSON parser
# (docs/decisions.md D-048). Numbers pass through as CMake prints them (17 significant digits),
# which read back as the same doubles.
function(hearthmap_semantic_cases json out)
  file(READ "${json}" doc)
  string(JSON base_w GET "${doc}" base canvas width)
  string(JSON base_h GET "${doc}" base canvas height)
  string(JSON base_poly GET "${doc}" base rooms 0 polygon)
  set(body "")
  string(JSON n LENGTH "${doc}" cases)
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON name GET "${doc}" cases ${i} name)
    string(JSON valid GET "${doc}" cases ${i} valid)
    string(JSON path ERROR_VARIABLE no_path GET "${doc}" cases ${i} path)
    if(no_path)
      set(path "")
    endif()
    if(valid)
      set(valid "true")
    else()
      set(valid "false")
    endif()
    set(points "")
    string(JSON poly ERROR_VARIABLE no_poly GET "${doc}" cases ${i} polygon)
    if(no_poly)
      set(poly "${base_poly}")
    endif()
    string(JSON np LENGTH "${poly}")
    math(EXPR plast "${np} - 1")
    foreach(k RANGE ${plast})
      string(JSON x GET "${poly}" ${k} 0)
      string(JSON y GET "${poly}" ${k} 1)
      string(APPEND points "{${x}, ${y}}, ")
    endforeach()
    string(JSON area ERROR_VARIABLE no_area GET "${doc}" cases ${i} map_area)
    if(no_area)
      set(rect "0, 0, ${base_w}, ${base_h}")
    else()
      string(JSON mx GET "${area}" x)
      string(JSON my GET "${area}" y)
      string(JSON mw GET "${area}" width)
      string(JSON mh GET "${area}" height)
      set(rect "${mx}, ${my}, ${mw}, ${mh}")
    endif()
    string(APPEND body "    {\"${name}\", ${valid}, \"${path}\", {${points}}, {${rect}}},\n")
  endforeach()
  set(text "// Generated from schema/semantic-cases.json by core/tests/semantic_cases.cmake. Do not edit.\n")
  string(APPEND text "#pragma once\n#include <vector>\n#include \"hearthmap/config.h\"\n")
  string(APPEND text "namespace hearthmap::test {\n")
  string(APPEND text "struct SemanticCase {\n  const char* name;\n  bool valid;\n  const char* path;\n")
  string(APPEND text "  std::vector<MapPoint> polygon;\n  CanvasRect map_area;\n};\n")
  string(APPEND text "inline constexpr int kSemanticCanvasWidth = ${base_w};\n")
  string(APPEND text "inline constexpr int kSemanticCanvasHeight = ${base_h};\n")
  string(APPEND text "inline const std::vector<SemanticCase>& semantic_cases() {\n")
  string(APPEND text "  static const std::vector<SemanticCase> cases = {\n${body}  };\n  return cases;\n}\n")
  string(APPEND text "}  // namespace hearthmap::test\n")
  file(CONFIGURE OUTPUT "${out}" CONTENT "${text}" @ONLY)
endfunction()
